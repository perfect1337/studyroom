# Notification Service environment variables
PORT=8085
DATABASE_URL=postgres://notification_service:devpassword123@localhost:5434/study_room_notifications?sslmode=disable
JWT_SECRET=change-me-in-production
SERVICE_TOKEN=change-me-service-token
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.ru
SMTP_PASSWORD=your-yandex-app-password
SMTP_FROM=no-reply@yourdomain.ru

# Origin'ы (через запятую), которым разрешён CORS с credentials. Пусто =
# браузерные cross-origin запросы с credentials заблокированы для всех
# origin'ов (безопасный дефолт). Для локальной разработки укажите адрес
# фронтенда, например http://localhost:5173. В проде — только реальный(е)
# домен(ы) фронтенда, никогда "*" вместе с credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
NATS_URL=nats://localhost:4222

# Used by contract tests when run locally
TEST_DATABASE_URL=postgres://notification_service:devpassword123@localhost:5434/study_room_notifications?sslmode=disable