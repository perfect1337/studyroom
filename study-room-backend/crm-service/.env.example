# CRM Service environment variables
PORT=8084
DATABASE_URL=postgres://crm_service:devpassword123@localhost:5436/study_room_crm?sslmode=disable
JWT_SECRET=change-me-in-production
NATS_URL=nats://localhost:4222
TILDA_WEBHOOK_SECRET=dev-tilda-secret

# Origin'ы (через запятую), которым разрешён CORS с credentials. Пусто =
# браузерные cross-origin запросы с credentials заблокированы для всех
# origin'ов (безопасный дефолт). Для локальной разработки укажите адрес
# фронтенда, например http://localhost:5173. В проде — только реальный(е)
# домен(ы) фронтенда, никогда "*" вместе с credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Used by contract tests when run locally
TEST_DATABASE_URL=postgres://crm_service:devpassword123@localhost:5436/study_room_crm?sslmode=disable
