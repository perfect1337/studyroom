# Academic Service environment variables
PORT=8082
DATABASE_URL=postgres://academic_service:devpassword123@localhost:5435/study_room_academic?sslmode=disable
JWT_SECRET=change-me-in-production
NATS_URL=nats://localhost:4222
USER_SERVICE_URL=http://localhost:8081

# Origin'ы (через запятую), которым разрешён CORS с credentials. Пусто =
# браузерные cross-origin запросы с credentials заблокированы для всех
# origin'ов (безопасный дефолт). Для локальной разработки укажите адрес
# фронтенда, например http://localhost:5173. В проде — только реальный(е)
# домен(ы) фронтенда, никогда "*" вместе с credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Used by contract tests when run locally
TEST_DATABASE_URL=postgres://academic_service:devpassword123@localhost:5435/study_room_academic?sslmode=disable
