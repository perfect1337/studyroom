# User Service environment variables
PORT=8081
DATABASE_URL=postgres://user_service:devpassword123@localhost:5433/study_room_users?sslmode=disable
JWT_SECRET=change-me-in-production
NATS_URL=nats://localhost:4222
APP_PUBLIC_URL=http://localhost:3000

# CIDR/IP реверс-прокси (nginx/ingress/LB) через запятую, которым разрешено
# доверять X-Forwarded-For для rate limit на /auth/* и аудит-логов.
# Пусто по умолчанию = X-Forwarded-For игнорируется, используется реальный
# TCP-адрес пира. Если сервис стоит за прокси — обязательно укажите его
# адрес (например TRUSTED_PROXIES=10.0.0.0/8), иначе rate limit тривиально
# обходится подделкой заголовка.
TRUSTED_PROXIES=

# Origin'ы (через запятую), которым разрешён CORS с credentials. Пусто =
# браузерные cross-origin запросы с credentials заблокированы для всех
# origin'ов (безопасный дефолт). Для локальной разработки укажите адрес
# фронтенда, например http://localhost:5173. В проде — только реальный(е)
# домен(ы) фронтенда, никогда "*" вместе с credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookie с refresh-токеном (httpOnly, недоступна из JS — защита от кражи
# долгоживущего токена через XSS, см. internal/handlers/cookies.go).
# COOKIE_SECURE=true — обязательно в проде (требует HTTPS). Для локальной
# разработки по http://localhost можно оставить true — Chrome/Firefox
# считают localhost "secure context" и всё равно ставят такую cookie; если
# у вас это не работает, поставьте false.
COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax подходит, если фронт и бэк — один и тот же
# registrable domain (порт значения не имеет, поэтому localhost:5173 и
# localhost:8081 — это ок). Если фронт и API на РАЗНЫХ доменах — ставьте
# None (и обязательно COOKIE_SECURE=true).
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN — опционально, например .studyroom.example.com, если нужно
# расшарить cookie между поддоменами. По умолчанию — только текущий host.
COOKIE_DOMAIN=

# Used by contract tests when run locally
TEST_DATABASE_URL=postgres://user_service:devpassword123@localhost:5433/study_room_users?sslmode=disable
