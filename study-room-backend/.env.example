# Скопируйте в .env и поменяйте значения перед запуском.
# docker compose автоматически подхватывает .env из той же папки.
# ВАЖНО: .env в .gitignore — не коммитьте реальные пароли/секреты.

USERS_DB_PASSWORD=devpassword123
NOTIFICATIONS_DB_PASSWORD=devpassword123
JWT_SECRET=change-me-in-production

# --- Notification Service ---
NOTIFICATIONS_SERVICE_TOKEN=change-me-service-token

# --- Яндекс SMTP (см. notification-service/README.md) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.ru
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=no-reply@yourdomain.ru
