# Root environment variables for docker compose and local service runs

# Database passwords for service containers
USERS_DB_PASSWORD=devpassword123
NOTIFICATIONS_DB_PASSWORD=devpassword123
ACADEMIC_DB_PASSWORD=devpassword123
CONTRACTS_DB_PASSWORD=devpassword123
CRM_DB_PASSWORD=devpassword123

# Shared secrets
JWT_SECRET=change-me-in-production
NOTIFICATIONS_SERVICE_TOKEN=change-me-service-token

# Optional frontend/public URL used by User Service when generating links
APP_PUBLIC_URL=http://localhost:3000

# Origin'ы (через запятую), которым разрешён CORS с credentials на всех
# сервисах (см. <service>/.env.example). Пусто = браузерные cross-origin
# запросы с credentials заблокированы для всех сайтов (безопасный дефолт,
# но локальный фронтенд тоже не сможет обратиться к API). Для локальной
# разработки: адрес(а) Vite dev-server и/или preview-сборки, например
# "http://localhost:5173,http://localhost:3000". В проде — только реальный(е)
# домен(ы) фронтенда, никогда "*" вместе с credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Список доверенных reverse-proxy (CIDR/IP через запятую) для rate limit
# на /auth/* — пусто по умолчанию (X-Forwarded-For игнорируется). См.
# user-service/.env.example.
TRUSTED_PROXIES=

# Cookie с refresh-токеном (httpOnly). false — только для локальной
# разработки по http://localhost; в проде обязательно true (нужен HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Notification Service SMTP settings (Yandex Mail example)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.ru
SMTP_PASSWORD=your-yandex-app-password
SMTP_FROM=no-reply@yourdomain.ru

# Optional service broker URL for local standalone runs
# In Docker Compose, services use the internal hostname nats://nats:4222.
NATS_URL=nats://localhost:4222

# Optional webhook secret for CRM Service
TILDA_WEBHOOK_SECRET=dev-tilda-secret
