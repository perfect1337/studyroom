diff --git a/study-room-backend/notification-service/Dockerfile b/study-room-backend/notification-service/Dockerfile
new file mode 100644
index 0000000..437076a
--- /dev/null
+++ b/study-room-backend/notification-service/Dockerfile
@@ -0,0 +1,17 @@
+# --- Build stage ---
+FROM golang:1.22-alpine AS builder
+
+ENV CGO_ENABLED=0
+
+WORKDIR /app
+COPY go.mod go.sum* ./
+RUN go mod download
+COPY . .
+RUN go mod tidy && go build -o /out/notification-service ./cmd/api
+
+# --- Final stage ---
+FROM alpine:3.19
+RUN apk add --no-cache ca-certificates
+COPY --from=builder /out/notification-service /notification-service
+EXPOSE 8085
+ENTRYPOINT ["/notification-service"]
