# ============================================================================
# Study Room Frontend — Production Environment
# ============================================================================
# Скопируйте в .env.production и .env.development:
#   cp .env.example .env.development
#   cp .env.example .env.production
# ============================================================================

# ---------------------------------------------------------------------------
# API Endpoints (адреса микросервисов)
# ---------------------------------------------------------------------------
# В dev окружении (localhost):
VITE_USERS_API=${VITE_USERS_API:-http://localhost:8081/api/v1}
VITE_ACADEMIC_API=${VITE_ACADEMIC_API:-http://localhost:8082/api/v1/academic}
VITE_CONTRACTS_API=${VITE_CONTRACTS_API:-http://localhost:8083/api/v1/contracts}
VITE_CRM_API=${VITE_CRM_API:-http://localhost:8084/api/v1/crm}
VITE_NOTIFICATIONS_API=${VITE_NOTIFICATIONS_API:-http://localhost:8085/api/v1/notifications}

# В продакшене все API идут через один домен (reverse proxy / gateway):
# VITE_USERS_API=https://api.studyroom.example.com/api/v1
# VITE_ACADEMIC_API=https://api.studyroom.example.com/api/v1/academic
# и т.д.

# ---------------------------------------------------------------------------
# Telegram-бот (кнопка "Открыть бота" в /settings и уведомлениях)
# ---------------------------------------------------------------------------
# Username бота БЕЗ "@" — должен ТОЧНО совпадать с тем, что реально
# зарегистрирован в @BotFather для TELEGRAM_BOT_TOKEN на бэкенде
# (notification-service/.env, TELEGRAM_BOT_TOKEN). Проверить: Telegram ->
# @BotFather -> /mybots -> выбрать бота -> username указан там же, где токен.
# Если это значение не совпадает с реальным username — ссылка "Открыть
# бота" ведёт на несуществующий/чужой чат, и Telegram не открывает диалог.
VITE_TELEGRAM_BOT_USERNAME=StudyRoomNotificationBot

# MAX bot username (without @), used for the "Open bot" link.
VITE_MAX_BOT_USERNAME=
