+import { useEffect, useMemo, useState } from "react";
+import DashboardShell from "../../components/layout/DashboardShell.jsx";
+import StatusBadge from "../../components/ui/StatusBadge.jsx";
+import { useAuth } from "../../context/AuthContext.jsx";
+import { fetchMyPeople, fetchBranches, createTutor, setUserActive, setTutorStatus } from "../../api/users.js";
+import { fetchCourses, fetchEnrollments } from "../../api/academic.js";
+import { toSidebarUser, fullName } from "../../utils/userDisplay.js";
+
+const PAGE_SIZE = 10;
+
+const TUTOR_STATUS_OPTIONS = [
+  { value: "active", label: "Активен" },
+  { value: "vacation", label: "В отпуске" },
+  { value: "sick_leave", label: "На больничном" },
+  { value: "inactive", label: "Неактивен (уволен)" },
+];
+
+function initials(person) {
+  if (!person) return "?";
+  return `${person.last_name?.[0] ?? ""}${person.first_name?.[0] ?? ""}`.toUpperCase() || "?";
+}
+
+/**
+ * Общая реализация "Список преподавателей" для owner (/admin/teachers) и
+ * branch_owner (/branch/teachers). Роль влияет на оформление шелла (DashboardShell/Sidebar)
+ * и на набор доступных действий: создание репетитора и деактивация аккаунта — только owner
+ * (см. api-contracts.md 1.11 и 1.14, там RequireRoles(RoleOwner) на бэкенде), а вот
+ * изменение рабочего статуса (отпуск/болен) доступно и branch_owner (1.15).
+ *
+ * Важный нюанс реального API: GET /users не возвращает specialization репетитора
+ * (эти поля в отдельной таблице tutor_profiles и не джойнятся в справочнике) —
+ * поэтому "предмет" мы честно показываем на основе курсов, которые репетитор
+ * реально ведёт (fetchEnrollments -> course.subject), а не выдумываем поле.
+ */
+export default function TeachersPage({ role }) {
+  const { user } = useAuth();
+  const isOwner = role === "admin";
+
+  const [tutors, setTutors] = useState([]);
+  const [courses, setCourses] = useState([]);
+  const [enrollments, setEnrollments] = useState([]);
+  const [branches, setBranches] = useState([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+
+  const [search, setSearch] = useState("");
+  const [activeSubject, setActiveSubject] = useState("all");
+  const [page, setPage] = useState(1);
+
+  const [rowActionError, setRowActionError] = useState("");
+  const [rowActionBusyId, setRowActionBusyId] = useState(null);
+
+  const [showAddModal, setShowAddModal] = useState(false);
+  const [addForm, setAddForm] = useState({
+    email: "",
+    lastName: "",
+    firstName: "",
+    patronymic: "",
+    specialization: "",
+    branchId: "",
+  });
+  const [addSubmitting, setAddSubmitting] = useState(false);
+  const [addError, setAddError] = useState("");
+  const [addResult, setAddResult] = useState(null);
+
+  async function loadAll() {
+    setLoading(true);
+    setError("");
+    try {
+      const requests = [fetchMyPeople(), fetchCourses(), fetchEnrollments()];
+      if (isOwner) requests.push(fetchBranches().catch(() => ({ items: [] })));
+      const results = await Promise.all(requests);
+      const [peopleRes, coursesRes, enrollRes, branchesRes] = results;
+      setTutors(peopleRes?.tutors ?? []);
+      setCourses(coursesRes?.items ?? []);
+      setEnrollments(enrollRes?.items ?? []);
+      if (isOwner) setBranches(branchesRes?.items ?? []);
+    } catch (e) {
+      setError(e.message || "Не удалось загрузить список преподавателей");
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    loadAll();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [role]);
+
+  const coursesById = useMemo(() => {
+    const map = {};
+    courses.forEach((c) => (map[c.id] = c));
+    return map;
+  }, [courses]);
+
+  // tutor_id -> { subjects: Set, activeStudents: Set(student_id) }
+  const tutorMeta = useMemo(() => {
+    const map = {};
+    for (const e of enrollments) {
+      if (!e.tutor_id) continue;
+      const bucket = (map[e.tutor_id] ??= { subjects: new Set(), activeStudents: new Set() });
+      const course = coursesById[e.course_id];
+      if (course?.subject) bucket.subjects.add(course.subject);
+      if (e.status === "active") bucket.activeStudents.add(e.student_id);
+    }
+    return map;
+  }, [enrollments, coursesById]);
+
+  const subjectList = useMemo(() => {
+    const set = new Set();
+    for (const meta of Object.values(tutorMeta)) {
+      meta.subjects.forEach((s) => set.add(s));
+    }
+    return Array.from(set).sort();
+  }, [tutorMeta]);
+
+  const tutorsEnriched = useMemo(
+    () =>
+      tutors.map((t) => {
+        const meta = tutorMeta[t.id];
+        return {
+          ...t,
+          subjects: meta ? Array.from(meta.subjects) : [],
+          activeStudents: meta ? meta.activeStudents.size : 0,
+        };
+      }),
+    [tutors, tutorMeta]
+  );
+
+  const filteredTutors = useMemo(() => {
+    const q = search.trim().toLowerCase();
+    return tutorsEnriched.filter((t) => {
+      if (activeSubject !== "all" && !t.subjects.includes(activeSubject)) return false;
+      if (!q) return true;
+      return fullName(t).toLowerCase().includes(q) || t.email?.toLowerCase().includes(q);
+    });
+  }, [tutorsEnriched, search, activeSubject]);
+
+  const totalPages = Math.max(1, Math.ceil(filteredTutors.length / PAGE_SIZE));
+  const currentPage = Math.min(page, totalPages);
+  const pageTutors = filteredTutors.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
+
+  useEffect(() => {
+    setPage(1);
+  }, [search, activeSubject]);
+
+  async function handleToggleActive(t) {
+    setRowActionError("");
+    setRowActionBusyId(t.id);
+    try {
+      await setUserActive(t.id, !t.is_active);
+      setTutors((prev) => prev.map((x) => (x.id === t.id ? { ...x, is_active: !t.is_active } : x)));
+    } catch (e) {
+      setRowActionError(e.message || "Не удалось изменить статус аккаунта");
+    } finally {
+      setRowActionBusyId(null);
+    }
+  }
+
+  async function handleSetTutorStatus(t, status) {
+    if (!status) return;
+    setRowActionError("");
+    setRowActionBusyId(t.id);
+    try {
+      await setTutorStatus(t.id, status);
+    } catch (e) {
+      setRowActionError(e.message || "Не удалось изменить рабочий статус");
+    } finally {
+      setRowActionBusyId(null);
+    }
+  }
+
+  async function handleAddTutor(e) {
+    e.preventDefault();
+    setAddError("");
+    setAddResult(null);
+    if (!addForm.email || !addForm.lastName || !addForm.firstName) {
+      setAddError("Email, фамилия и имя обязательны");
+      return;
+    }
+    setAddSubmitting(true);
+    try {
+      const res = await createTutor({
+        email: addForm.email,
+        last_name: addForm.lastName,
+        first_name: addForm.firstName,
+        patronymic: addForm.patronymic || undefined,
+        specialization: addForm.specialization || undefined,
+        branch_id: addForm.branchId ? Number(addForm.branchId) : undefined,
+      });
+      setAddResult(res);
+      await loadAll();
+      setAddForm({ email: "", lastName: "", firstName: "", patronymic: "", specialization: "", branchId: "" });
+    } catch (e) {
+      setAddError(e.message || "Не удалось создать преподавателя");
+    } finally {
+      setAddSubmitting(false);
+    }
+  }
+
+  const shellProps =
+    role === "admin"
+      ? { role: "admin", user: toSidebarUser(user), searchPlaceholder: "Поиск учеников или учителей..." }
+      : {
+          role: "branch_owner",
+          user: toSidebarUser(user),
+          searchPlaceholder: "Поиск по филиалу...",
+          userLabel: fullName(user),
+          avatarUrl: user?.avatar_url,
+        };
+
+  return (
+    <DashboardShell {...shellProps}>
+      <div className="p-gutter max-w-container-max mx-auto space-y-stack-lg">
+        <div className="flex items-center justify-between mt-4">
+          <h2 className="font-headline-md text-headline-md font-bold text-primary">Список преподавателей</h2>
+          <div className="relative hidden lg:block">
+            <span className="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">
+              search
+            </span>
+            <input
+              value={search}
+              onChange={(e) => setSearch(e.target.value)}
+              className="bg-surface-container-low border-none rounded-full py-2 pl-10 pr-4 w-64 text-label-md focus:ring-2 focus:ring-primary-container outline-none transition-all"
+              placeholder="Поиск преподавателя..."
+              type="text"
+            />
+          </div>
+        </div>
+
+        {error && (
+          <div className="p-3 rounded-lg bg-error-container text-on-error-container font-label-md text-label-md">{error}</div>
+        )}
+        {rowActionError && (
+          <div className="p-3 rounded-lg bg-error-container text-on-error-container font-label-md text-label-md">
+            {rowActionError}
+          </div>
+        )}
+
+        <section className="flex flex-col md:flex-row justify-between items-start md:items-center gap-stack-md">
+          <div className="flex gap-2 overflow-x-auto pb-2 md:pb-0 w-full md:w-auto">
+            <button
+              onClick={() => setActiveSubject("all")}
+              className={`px-4 py-2 rounded-full font-label-md text-label-md flex items-center gap-2 transition-all whitespace-nowrap ${
+                activeSubject === "all" ? "bg-primary text-on-primary hover:shadow-md" : "bg-surface-container-highest text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container"
+              }`}
+            >
+              Все ({tutorsEnriched.length})
+            </button>
+            {subjectList.map((s) => (
+              <button
+                key={s}
+                onClick={() => setActiveSubject(s)}
+                className={`px-4 py-2 rounded-full font-label-md text-label-md whitespace-nowrap transition-all ${
+                  activeSubject === s ? "bg-primary text-on-primary hover:shadow-md" : "bg-surface-container-highest text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container"
+                }`}
+              >
+                {s}
+              </button>
+            ))}
+          </div>
+          {isOwner && (
+            <button
+              onClick={() => {
+                setShowAddModal(true);
+                setAddError("");
+                setAddResult(null);
+              }}
+              className="bg-secondary-container text-on-secondary-container px-6 py-2.5 rounded-lg font-bold flex items-center gap-2 hover:shadow-[0px_4px_12px_rgba(254,208,27,0.3)] transition-all active:scale-95 whitespace-nowrap"
+            >
+              <span className="material-symbols-outlined">person_add</span>
+              Добавить преподавателя
+            </button>
+          )}
+        </section>
+
+        <div className="bg-surface-container-lowest rounded-xl shadow-[0px_10px_30px_rgba(0,0,0,0.05)] border border-outline-variant overflow-hidden">
+          <div className="overflow-x-auto">
+            <table className="w-full text-left border-collapse min-w-[860px]">
+              <thead className="bg-surface-container-low text-on-surface-variant border-b border-outline-variant">
+                <tr>
+                  <th className="px-6 py-4 font-label-md text-label-md">ФИО Преподавателя</th>
+                  <th className="px-6 py-4 font-label-md text-label-md">Предметы</th>
+                  <th className="px-6 py-4 font-label-md text-label-md">Активные ученики</th>
+                  <th className="px-6 py-4 font-label-md text-label-md">Статус аккаунта</th>
+                  <th className="px-6 py-4 font-label-md text-label-md text-right">Рабочий статус</th>
+                </tr>
+              </thead>
+              <tbody className="divide-y divide-outline-variant">
+                {loading && (
+                  <tr>
+                    <td colSpan={5} className="px-6 py-10 text-center text-on-surface-variant">Загрузка…</td>
+                  </tr>
+                )}
+                {!loading && pageTutors.length === 0 && (
+                  <tr>
+                    <td colSpan={5} className="px-6 py-10 text-center text-on-surface-variant">
+                      {tutorsEnriched.length === 0 ? "Преподавателей пока нет" : "Ничего не найдено по вашему запросу"}
+                    </td>
+                  </tr>
+                )}
+                {pageTutors.map((t) => (
+                  <tr key={t.id} className="group hover:bg-surface-container-low transition-colors">
+                    <td className="px-6 py-4">
+                      <div className="flex items-center gap-4">
+                        <div className="h-12 w-12 rounded-lg bg-surface-variant overflow-hidden flex items-center justify-center font-bold text-primary shrink-0">
+                          {t.avatar_url ? (
+                            <img src={t.avatar_url} alt={fullName(t)} className="w-full h-full object-cover" />
+                          ) : (
+                            initials(t)
+                          )}
+                        </div>
+                        <div>
+                          <div className="font-body-md text-body-md font-bold text-on-surface">{fullName(t)}</div>
+                          <div className="text-label-md text-on-surface-variant">ID: {t.id}</div>
+                        </div>
+                      </div>
+                    </td>
+                    <td className="px-6 py-4">
+                      <div className="flex flex-wrap gap-1 max-w-[220px]">
+                        {t.subjects.length === 0 && <span className="text-label-md text-on-surface-variant">—</span>}
+                        {t.subjects.map((s) => (
+                          <span key={s} className="bg-primary-fixed text-on-primary-fixed px-3 py-1 rounded-full text-label-md font-medium">
+                            {s}
+                          </span>
+                        ))}
+                      </div>
+                    </td>
+                    <td className="px-6 py-4">
+                      <span className="font-body-md text-body-md font-bold">{t.activeStudents}</span>
+                    </td>
+                    <td className="px-6 py-4">
+                      <div className="flex items-center gap-3">
+                        <StatusBadge status={t.is_active ? "Активен" : "Неактивен"} color={t.is_active ? "green" : "red"} />
+                        {isOwner && (
+                          <button
+                            disabled={rowActionBusyId === t.id}
+                            onClick={() => handleToggleActive(t)}
+                            className="text-label-md text-primary hover:underline disabled:opacity-50 whitespace-nowrap"
+                          >
+                            {t.is_active ? "Деактивировать" : "Активировать"}
+                          </button>
+                        )}
+                      </div>
+                    </td>
+                    <td className="px-6 py-4 text-right">
+                      <select
+                        disabled={rowActionBusyId === t.id}
+                        defaultValue=""
+                        onChange={(e) => {
+                          handleSetTutorStatus(t, e.target.value);
+                          e.target.value = "";
+                        }}
+                        className="bg-surface border border-outline-variant rounded-lg text-label-md py-1.5 px-2 focus:outline-none focus:border-primary"
+                      >
+                        <option value="" disabled>
+                          Изменить…
+                        </option>
+                        {TUTOR_STATUS_OPTIONS.filter((o) => o.value !== "inactive" || isOwner).map((o) => (
+                          <option key={o.value} value={o.value}>
+                            {o.label}
+                          </option>
+                        ))}
+                      </select>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
